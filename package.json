{
  "name": "dsh-moyu",
  "version": "0.1.2",
  "description": "摸鱼套件 dsh-moyu 的抖音模块：悬停唤出的推荐流播放器，滚轮切视频，宿主侧做签名与媒体反代，无需登录。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "moyu",
    "摸鱼",
    "douyin",
    "抖音",
    "client-plugin",
    "video",
    "recommend-feed"
  ],
  "license": "MIT",
  "author": "gongstudent",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gongstudent/dsh-moyu.git"
  },
  "homepage": "https://github.com/gongstudent/dsh-moyu#readme",
  "bugs": {
    "url": "https://github.com/gongstudent/dsh-moyu/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "vendor",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "ARCHITECTURE.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  }
}
